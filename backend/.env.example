# Database
# For local PostgreSQL: postgresql+asyncpg://admin:password@localhost:5432/claude_remote
# For Docker Compose: postgresql+asyncpg://admin:password@localhost:25432/claude_remote
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:25432/claude_remote

# Authentication
JWT_SECRET=your-secret-key-min-32-characters-long-please-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Claude Code
# Path to claude executable (required for remote command execution)
# On Linux/Mac: usually /home/user/.local/bin/claude or $(which claude)
# On Windows: C:\Users\Username\AppData\Local\Programs\Claude\claude.exe
# Run: which claude (Linux/Mac) or where claude (Windows) to find the path
CLAUDE_CODE_PATH=/home/user/.local/bin/claude

# Working directory for Claude Code process
# Claude will execute commands in this directory
# Default is current directory (.)
# Examples: /path/to/your/project, ./my-codebase, /home/user/workspace
CLAUDE_WORKING_DIRECTORY=.

# Claude Code timeout in seconds
CLAUDE_CODE_TIMEOUT=300

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS
# Comma-separated list of allowed origins (for frontend development and production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Logging Configuration
# Directory for application log files (rotating: 3MB x 3 files)
LOG_DIR=logs

# Application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# DEBUG: Most verbose, includes all details
# INFO: General information about application state (recommended for development)
# WARNING: Warning messages only
# ERROR: Error messages only
# CRITICAL: Critical errors only
LOG_LEVEL=INFO

# SQLAlchemy SQL query logging level
# WARNING: Default - suppresses SQL queries (logs are still in files, just not to console)
# INFO: Shows all SQL SELECT/INSERT/UPDATE/DELETE queries
# DEBUG: Shows SQL with parameters
# Use WARNING for clean console output during normal development
# Use INFO only when debugging database issues
SQLALCHEMY_LOG_LEVEL=WARNING
