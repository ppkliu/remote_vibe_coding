# Production Environment Configuration
# Copy to .env.production and update values
# ⚠️  KEEP SECRETS SECURE - NEVER COMMIT ACTUAL VALUES

# Backend Configuration
BACKEND_HOST=backend-prod.internal
BACKEND_PORT=8000
BACKEND_DEBUG=false

# Database (PRODUCTION MUST USE MANAGED SERVICE)
DB_HOST=rds-prod.amazonaws.com
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=CHANGE_ME_USE_SECRETS_MANAGER
DB_NAME=claude_remote

# Logging
LOG_DIR=/var/log/claude-backend
LOG_LEVEL=INFO
SQLALCHEMY_LOG_LEVEL=WARNING

# Claude Code
CLAUDE_CODE_PATH=/usr/local/bin/claude
CLAUDE_WORKING_DIRECTORY=/opt/claude-work

# JWT
JWT_SECRET=CHANGE_ME_USE_SECRETS_MANAGER
JWT_ALGORITHM=HS256

# Frontend
FRONTEND_URL=https://example.com
CORS_ORIGINS=https://example.com

# Monitoring
SENTRY_DSN=https://key@sentry.io/project-id
DATADOG_API_KEY=CHANGE_ME_USE_SECRETS_MANAGER

