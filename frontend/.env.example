# Backend API Configuration
# REST API endpoint for HTTP requests
# Make sure the backend is running on this URL
VITE_API_URL=http://localhost:8000/api/v1

# WebSocket endpoint for real-time communication with Claude
# Used for streaming responses and session management
# Must use 'ws://' for development and 'wss://' for production
VITE_WS_URL=ws://localhost:8000/ws
