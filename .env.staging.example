# Staging Environment Configuration
# Copy to .env.staging and update values

# Backend Configuration
BACKEND_HOST=backend-staging.internal
BACKEND_PORT=8000
BACKEND_DEBUG=false

# Database
DB_HOST=postgres-staging.internal
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=staging_password_change_me
DB_NAME=claude_remote_staging

# Logging
LOG_DIR=/var/log/claude-backend
LOG_LEVEL=DEBUG
SQLALCHEMY_LOG_LEVEL=INFO

# Claude Code
CLAUDE_CODE_PATH=/usr/local/bin/claude
CLAUDE_WORKING_DIRECTORY=/opt/claude-work

# JWT
JWT_SECRET=staging_jwt_secret_change_me
JWT_ALGORITHM=HS256

# Frontend
FRONTEND_URL=https://staging.example.com
CORS_ORIGINS=https://staging.example.com

# Monitoring
SENTRY_DSN=https://key@sentry.io/project-id
DATADOG_API_KEY=dd_api_key_staging

